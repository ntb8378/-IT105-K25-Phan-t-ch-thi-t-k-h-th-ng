        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml class_diagram\ntitle Class Diagram Tổng Thể - Hệ Thống DentCare\n\nclass Patient {\n  - patientId: String {PK}\n  - fullName: String\n  - phoneNumber: String\n  - dob: Date\n  - gender: String\n  + viewMedicalHistory(): List\n  + register(): Boolean\n}\n\nclass Dentist {\n  - dentistId: String {PK}\n  - fullName: String\n  - specialization: String\n  - phone: String\n  + getDailySchedule(date: Date): List\n}\n\nclass Appointment {\n  - appointmentId: String {PK}\n  - patientId: String {FK}\n  - dentistId: String {FK}\n  - appointmentDate: Date\n  - timeSlot: String\n  - status: String\n  + confirmAppointment(): void\n  + cancelAppointment(reason: String): Boolean\n}\n\nclass MedicalRecord {\n  - recordId: String {PK}\n  - appointmentId: String {FK}\n  - diagnosis: String\n  - dentistNotes: String\n  - createdAt: DateTime\n  + addPrescription(): void\n  + lockRecord(): void\n}\n\nclass Invoice {\n  - invoiceId: String {PK}\n  - recordId: String {FK}\n  - totalAmount: Double\n  - paymentStatus: String\n  - createdAt: DateTime\n  + calculateTotal(): Double\n  + printInvoice(): void\n}\n\nclass InvoiceDetail {\n  - invoiceDetailId: String {PK}\n  - invoiceId: String {FK}\n  - serviceId: String {FK}\n  - quantity: Integer\n  - unitPrice: Double\n  + calculateLineTotal(): Double\n}\n\nclass DentalService {\n  - serviceId: String {PK}\n  - serviceName: String\n  - price: Double\n  - description: String\n  + updatePrice(newPrice: Double): void\n}\n\nabstract class PaymentMethod {\n  # paymentMethodId: String {PK}\n  # amount: Double\n  # paymentDate: DateTime\n  + {abstract} processPayment(): Boolean\n}\n\nclass CashPayment {\n  - cashTendered: Double\n  - changeAmount: Double\n  + calculateChange(): Double\n  + processPayment(): Boolean\n}\n\nclass TransferPayment {\n  - bankCode: String\n  - transactionRef: String\n  + verifyTransaction(): Boolean\n  + processPayment(): Boolean\n}\n\n&#39; Mối quan hệ và Bản số (Multiplicity)\nPatient \&quot;1\&quot; -- \&quot;0..*\&quot; Appointment : đặt &gt;\nDentist \&quot;1\&quot; -- \&quot;0..*\&quot; Appointment : phụ trách &gt;\nAppointment \&quot;1\&quot; -- \&quot;1\&quot; MedicalRecord : dẫn đến &gt;\nMedicalRecord \&quot;1\&quot; -- \&quot;1\&quot; Invoice : xuất &gt;\n\nInvoice \&quot;1\&quot; *-- \&quot;1..*\&quot; InvoiceDetail : bao gồm (Composition) &gt;\nDentalService \&quot;1\&quot; -- \&quot;0..*\&quot; InvoiceDetail : tham chiếu &gt;\n\nInvoice \&quot;1\&quot; -- \&quot;1\&quot; PaymentMethod : áp dụng &gt;\nPaymentMethod &lt;|-- CashPayment : kế thừa (Generalization)\nPaymentMethod &lt;|-- TransferPayment : kế thừa (Generalization)\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="I12sn7LnhGPiePR9djo5-135">
