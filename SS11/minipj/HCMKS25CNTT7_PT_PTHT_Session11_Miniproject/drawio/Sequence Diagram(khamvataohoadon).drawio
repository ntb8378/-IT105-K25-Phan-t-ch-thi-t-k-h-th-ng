        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml seq_treatment_invoice\ntitle Tuần Tự (Sequence Diagram) - Khám Bệnh &amp; Tạo Hóa Đơn\n\nactor \&quot;Nha sĩ\&quot; as NS\nparticipant \&quot;:KhamBenhUI\&quot; as UI\nparticipant \&quot;:RecordService\&quot; as RecSvc\nparticipant \&quot;:InvoiceService\&quot; as InvSvc\ndatabase \&quot;:CSDL\&quot; as DB\n\nNS -&gt; UI: 1. Nhap chan doan &amp; Chon cac dich vu da lam\nactivate UI\n\nUI -&gt; RecSvc: 2. saveRecord(aptId, diagnosis, notes)\nactivate RecSvc\n\nRecSvc -&gt; DB: 3. INSERT INTO MedicalRecord\nactivate DB\nDB --&gt; RecSvc: 4. Tra ve recordId\ndeactivate DB\n\nRecSvc --&gt; UI: 5. Xac nhan luu benh an thanh cong\ndeactivate RecSvc\n\nUI -&gt; InvSvc: 6. generateInvoice(recordId, listServices)\nactivate InvSvc\n\nloop Cho moi dich vu trong danh sach\n  InvSvc -&gt; DB: 7. INSERT INTO InvoiceDetail (serviceId, qty, price)\n  activate DB\n  DB --&gt; InvSvc: 8. Xac nhan them chi tiet\n  deactivate DB\nend\n\nInvSvc -&gt; InvSvc: 9. totalAmount = calcTotal()\nInvSvc -&gt; DB: 10. INSERT INTO Invoice (recordId, totalAmount, status=&#39;ChuaThanhToan&#39;)\nactivate DB\nDB --&gt; InvSvc: 11. Tra ve invoiceId\ndeactivate DB\n\nInvSvc --&gt; UI: 12. invoiceCreated(invoiceId, totalAmount)\ndeactivate InvSvc\n\nopt Benh nhan yeu cau in hoa don\n  UI -&gt; InvSvc: 13. printInvoice(invoiceId)\n  activate InvSvc\n  InvSvc --&gt; UI: 14. Xuat file PDF hoa don\n  deactivate InvSvc\nend\n\nUI --&gt; NS: 15. Hoan tat phien kham &amp; chuyen benh nhan ra quay\ndeactivate UI\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="I12sn7LnhGPiePR9djo5-337">
